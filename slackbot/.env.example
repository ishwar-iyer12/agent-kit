# Slack app (create from slack-manifest.yaml at https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information -> App-Level Tokens, scope connections:write
TICKETBOT_REACTION=ticket         # emoji that triggers a run without a mention (:ticket:)

# Claude API (Console workspace "ci-review", same key as the PR reviewer)
ANTHROPIC_API_KEY=sk-ant-...
TICKETBOT_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 to run cheaper

# Trackers: whichever each project's agent.json names
TRELLO_KEY=
TRELLO_TOKEN=
LINEAR_API_KEY=

# Channel -> project map (see ../schema/projects.json.example). Default ./projects.json
TICKETBOT_PROJECTS=projects.json

# Optional: one-line audit per run into #eng-agent
SLACK_WEBHOOK_URL=

# docker compose only: where the project repos are cloned on this host (read for agent.json)
REPOS_DIR=/home/deploy
